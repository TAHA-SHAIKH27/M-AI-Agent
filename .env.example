# M AI Assistant - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
M_DEBUG=false
M_APP_NAME=M
M_APP_VERSION=0.1.0-dev
M_DATA_DIR=C:\Users\taha\AppData\Local\M

# =============================================================================
# NVIDIA NEMOTRON 3 ULTRA (PRIMARY MODEL)
# Get your API key from: https://build.nvidia.com
# =============================================================================
M_NVIDIA_API_KEY=
M_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
M_NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# =============================================================================
# FALLBACK MODEL PROVIDERS
# =============================================================================

# Ollama (local) - install from https://ollama.ai
M_OLLAMA_BASE_URL=http://localhost:11434
M_OLLAMA_MODEL=llama3.2:3b

# LM Studio (local) - install from https://lmstudio.ai
M_LM_STUDIO_BASE_URL=http://localhost:1234/v1

# OpenAI (cloud fallback)
M_OPENAI_API_KEY=
M_OPENAI_BASE_URL=https://api.openai.com/v1
M_OPENAI_MODEL=gpt-4o-mini

# Anthropic (cloud fallback)
M_ANTHROPIC_API_KEY=
M_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
M_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# MEMORY SETTINGS
# =============================================================================
M_MEMORY_STM_TTL_SECONDS=3600
M_MEMORY_EPISODIC_DB=sqlite:///data/memory/episodic.db
M_MEMORY_SEMANTIC_PATH=data/memory/semantic
M_MEMORY_PROCEDURAL_PATH=data/memory/procedural

# =============================================================================
# VOICE SETTINGS
# =============================================================================
M_WHISPER_MODEL=large-v3-turbo
M_WHISPER_DEVICE=cuda
M_WHISPER_COMPUTE_TYPE=float16
M_KOKORO_VOICE=af_sky
M_KOKORO_SPEED=1.0
M_WAKE_WORD_ENABLED=false
M_WAKE_WORD_ACCESS_KEY=  # Get from https://console.picovoice.ai/

# =============================================================================
# PHONE / TWILIO SETTINGS
# =============================================================================
M_TWILIO_ACCOUNT_SID=
M_TWILIO_AUTH_TOKEN=
M_TWILIO_PHONE_NUMBER=
M_TWILIO_WEBHOOK_URL=

# =============================================================================
# ANDROID COMPANION SETTINGS
# =============================================================================
M_ANDROID_COMPANION_ENABLED=false
M_ANDROID_COMPANION_PORT=8765

# =============================================================================
# WINDOWS AUTOMATION SETTINGS
# =============================================================================
M_UIA_TIMEOUT_MS=5000
M_UIA_RETRY_COUNT=3

# =============================================================================
# BROWSER SETTINGS
# =============================================================================
M_PLAYWRIGHT_HEADLESS=true
M_PLAYWRIGHT_BROWSER=chromium

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
M_ENCRYPTION_KEY=  # Auto-generated on first run
M_AUDIT_LOG_ENABLED=true
M_CONSENT_REQUIRED=true

# =============================================================================
# API SERVER SETTINGS
# =============================================================================
M_API_HOST=127.0.0.1
M_API_PORT=8080
M_WS_PORT=8081